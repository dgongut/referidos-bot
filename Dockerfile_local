FROM alpine:3.24.2

ENV PYTHONUNBUFFERED=1

RUN apk add --no-cache python3 py3-pip tzdata font-dejavu

WORKDIR /app
COPY requirements.txt .
RUN PIP_BREAK_SYSTEM_PACKAGES=1 pip3 install --no-cache-dir -r requirements.txt
COPY config.py referidos.py ./

RUN adduser -D -H bot
USER bot

ENTRYPOINT ["python3", "referidos.py"]
